# Alchemy Starknet Sepolia RPC API key (the final path segment of the RPC URL).
# Get one at https://www.alchemy.com/ — Starknet Sepolia app.
# Copy this file to .env for local dev; it is also injected by Vercel as env var RPC_KEY.
RPC_KEY=

# Cartridge RPC token (sk_...) authorizing the Controller's session execution
# against api.cartridge.gg. Create with: slot rpc tokens create --team <team>
CONTROLLER_RPC_KEY=
