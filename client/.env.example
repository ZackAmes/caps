# Cartridge RPC token (sk_...) authorizing RPC access from the browser.
# Copy this file to .env for local dev; set in Vercel as env var for deploys.
CONTROLLER_RPC_KEY=

# DEV MODE (optional): bypass Controller entirely with a raw funded account.
# WARNING: the private key ships in the client bundle — use a throwaway
# account funded with test STRK only. When set, the app skips Controller
# sign-in ("Enter Dev Mode") and pays gas directly from this account.
DEV_ACCOUNT_ADDRESS=
DEV_PRIVATE_KEY=
