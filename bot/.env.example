BOT_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia/rpc/v0_9
BOT_ADDRESS=0x...
BOT_PRIVATE_KEY=0x...
BOT_POLL_MS=15000
# Optional overrides; defaults use the repository manifest and bot/state/checkpoint.json.
# BOT_ACTIONS_ADDRESS=0x...
# BOT_STATE_PATH=/absolute/path/checkpoint.json
# BOT_MANIFEST_PATH=/absolute/path/manifest.json

# Local Torii wakes the worker immediately; empty disables subscriptions.
BOT_TORII_URL=http://127.0.0.1:8081
